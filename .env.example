# Minimum setup: add a Perplexity API key. It enables Perplexity research and
# can route Claude/Grok reasoning calls when direct provider keys are absent.
PERPLEXITY_API_KEY=

# Optional. Enables direct Claude calls instead of Perplexity routing.
ANTHROPIC_API_KEY=

# Optional. Enables direct Grok plus native X search.
XAI_API_KEY=

# Optional override. If omitted, the private MCP path token is derived one-way
# from the first configured provider key (Perplexity, then Anthropic, then xAI).
MCP_ACCESS_TOKEN=

PORT=3000
CLAUDE_MODEL=claude-opus-5
PERPLEXITY_CLAUDE_MODEL=anthropic/claude-opus-5
GROK_MODEL=grok-4.6
PERPLEXITY_GROK_MODEL=xai/grok-4.6
MAX_PROMPT_CHARS=120000
MAX_OUTPUT_TOKENS=8000
UPSTREAM_TIMEOUT_MS=240000
MAX_REQUESTS_PER_MINUTE=60
